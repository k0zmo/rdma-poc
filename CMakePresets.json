{
    "version": 3,
    "configurePresets": [
        {
            "name": ":base",
            "hidden": true,
            "binaryDir": "${sourceDir}/build/${presetName}",
            "installDir": "${sourceDir}/install/${presetName}",
            "generator": "Ninja",
            "cacheVariables": {
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "CMAKE_COLOR_DIAGNOSTICS": "ON",
                "concurrentqueue_ROOT": "${sourceDir}/vendor/concurrentqueue"
            }
        },
        {
            "name": ":windows",
            "hidden": true,
            "inherits": [":base"],
            "condition": { "type": "equals", "rhs": "Windows", "lhs": "${hostSystemName}" },
            "cacheVariables": {
                "libfabric_ROOT": "D:\\Programowanie\\pkgs\\libfabric"
            }
        },
        {
            "name": ":linux",
            "hidden": true,
            "inherits": [":base"],
            "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" },
            "cacheVariables": {
                "libfabric_ROOT": "/opt/libfabric"
            },
            "vendor": {
                "microsoft.com/VisualStudioRemoteSettings/CMake/1.0": {
                    "sourceDir": "$env{HOME}/.vs/$ms{projectDirName}",
                    "copySourcesOptions": {
                        "exclusionList": [
                            ".vs",
                            ".vscode",
                            ".git",
                            ".cache",
                            "build",
                            "install",
                            "out"
                        ]
                    }
                }
            }
        },
        {
            "name": ":msvc",
            "hidden": true,
            "cacheVariables": {
                "CMAKE_CXX_COMPILER": "cl",
                "CMAKE_CXX_FLAGS": "/utf-8 /W4 /GR /wd4996 /EHsc /wd4127 /wd4251 /wd4275 /permissive- /Zc:inline /Zc:throwingNew /Zc:preprocessor /volatile:iso /DWIN32 /D_WINDOWS /D_SCL_SECURE_NO_WARNINGS /DWIN32_LEAN_AND_MEAN /D_WIN32_WINNT=0x0A00",
                "CMAKE_CXX_FLAGS_DEBUG"  : "/JMC /Zi /Od",
                "CMAKE_CXX_FLAGS_RELEASE": "/Zi /O2 /Oi /Ob2 /DNDEBUG /Gw /Gy",
                "CMAKE_EXE_LINKER_FLAGS_DEBUG"     : "/DEBUG:FASTLINK /INCREMENTAL",
                "CMAKE_MODULE_LINKER_FLAGS_DEBUG"  : "/DEBUG:FASTLINK /INCREMENTAL",
                "CMAKE_SHARED_LINKER_FLAGS_DEBUG"  : "/DEBUG:FASTLINK /INCREMENTAL",
                "CMAKE_EXE_LINKER_FLAGS_RELEASE"   : "/DEBUG /INCREMENTAL:NO /OPT:REF /OPT:ICF",
                "CMAKE_MODULE_LINKER_FLAGS_RELEASE": "/DEBUG /INCREMENTAL:NO /OPT:REF /OPT:ICF",
                "CMAKE_SHARED_LINKER_FLAGS_RELEASE": "/DEBUG /INCREMENTAL:NO /OPT:REF /OPT:ICF"
            }
        },
        {
            "name": ":gcc",
            "hidden": true,
            "cacheVariables": {
                "CMAKE_CXX_FLAGS": "-Wall -Wextra -Wpedantic",
                "CMAKE_CXX_FLAGS_DEBUG"  : "-O0 -g",
                "CMAKE_CXX_FLAGS_RELEASE": "-O3 -DNDEBUG",
                "CMAKE_EXE_LINKER_FLAGS"   : "-Wl,--exclude-libs=ALL -Wl,-z,defs -Wl,--as-needed",
                "CMAKE_MODULE_LINKER_FLAGS": "-Wl,--exclude-libs=ALL -Wl,-z,defs -Wl,--as-needed",
                "CMAKE_SHARED_LINKER_FLAGS": "-Wl,--exclude-libs=ALL -Wl,-z,defs -Wl,--as-needed"
            }
        },
        {
            "name": ":debug",
            "hidden": true,
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": ":release",
            "hidden": true,
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_INTERPROCEDURAL_OPTIMIZATION": "ON"
            }
        },
        {
            "name": ":asan",
            "hidden": true,
            "cacheVariables": {
                "CMAKE_CXX_FLAGS_ASAN": "-O1 -g -fsanitize=address -fno-omit-frame-pointer -DNDEBUG",
                "CMAKE_BUILD_TYPE": "ASan"
            }
        },
        {
            "name": ":x64-arch-external",
            "hidden": true,
            "architecture": { "strategy": "external", "value": "x64" },
            "toolset":      { "strategy": "external", "value": "host=x64" }
        },
        {
            "name": "gcc-debug",
            "inherits": [":linux", ":gcc", ":debug"]
        },
        {
            "name": "gcc-release",
            "inherits": [":linux", ":gcc", ":release"]
        },
        {
            "name": "gcc-asan",
            "inherits": [":linux", ":gcc", ":asan"]
        },
        {
            "name": "msvc-debug",
            "inherits": [":windows", ":msvc", ":x64-arch-external", ":debug"]
        },
        {
            "name": "msvc-release",
            "inherits": [":windows", ":msvc", ":x64-arch-external", ":release"]
        }
    ]
}