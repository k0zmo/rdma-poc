{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "type": "lldb",
            "request": "attach",
            "name": "Attach",
            "program": "${workspaceFolder}/build/Linux-GCC-Debug/efa_sender"
        },
        {
            "type": "lldb",
            "request": "launch",
            "name": "Launch",
            "program": "${command:cmake.launchTargetPath}",
            "args": [
                //"-a", "192.168.110.10",
                //"-p", "efa",
                //"-B", "4224"
                //"-a", "127.0.0.1"
            ],
            "cwd": "${command:cmake.launchTargetDirectory}",
            "env": {
                "FI_PROVIDER_PATH": "/opt/libfabric/lib/libfabric"
            }
        },
        {
            "type": "lldb",
            "request": "launch",
            "name": "EFA sender",
            "program": "${workspaceFolder}/build/Linux-GCC-Debug/efa_sender",
            "args": [
                //"-a", "192.168.110.10",
                //"-p", "efa",
                //"-B", "4224"
                //"-a", "127.0.0.1"
            ],
            "cwd": "${workspaceFolder}/build/Linux-GCC-Debug",
            "env": {
                "FI_PROVIDER_PATH": "/opt/libfabric/lib/libfabric"
            }
        },
        {
            "type": "lldb",
            "request": "launch",
            "name": "EFA receiver",
            "program": "${workspaceFolder}/build/Linux-GCC-Debug/efa_receiver",
            "args": [
                //"-a", "192.168.110.10",
                //"-p", "efa",
                //"-B", "4224"
                "-a", "127.0.0.1"
            ],
            "cwd": "${workspaceFolder}/build/Linux-GCC-Debug",
            "env": {
                "FI_PROVIDER_PATH": "/opt/libfabric/lib/libfabric"
            }
        }
    ]
}